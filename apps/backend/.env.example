# Backend environment variables.
# Copy this file to .env and fill in real values.
# The real .env file is gitignored and must never be committed.

# Supabase project URL.
# Same value as VITE_SUPABASE_URL in the frontend.
SUPABASE_URL=https://your-project-id.supabase.co

# Supabase service-role secret key.
# Server-side only. NEVER expose this in frontend code.
# Find it in the Supabase dashboard under Settings → API → Service Role Key.
SUPABASE_KEY=your-supabase-service-role-key-here