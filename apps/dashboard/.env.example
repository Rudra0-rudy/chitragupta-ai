# Frontend environment variables.
# Copy this file to .env.local and fill in real values.
# The real .env.local file is gitignored and must never be committed.

# Supabase project URL.
# Find it in the Supabase dashboard under Settings → API → Project URL.
VITE_SUPABASE_URL=https://your-project-id.supabase.co

# Supabase publishable (anon) key.
# Safe to expose in frontend code — designed for browser use.
VITE_SUPABASE_PUBLISHABLE_KEY=your-supabase-publishable-key-here

# Backend API URL.
# Local development: http://127.0.0.1:5000
# Production: the full URL of the deployed Flask backend on Render,
# e.g. https://chitragupta-ai-backend.onrender.com
VITE_BACKEND_URL=http://127.0.0.1:5000